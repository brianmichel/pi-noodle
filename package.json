{
  "name": "pi-extension-mem0-client",
  "version": "0.1.0",
  "description": "Pi extension for talking to a self-hosted Mem0 REST API.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "mem0"
  ],
  "engines": {
    "node": ">=22"
  },
  "files": [
    "index.ts",
    "src",
    "README.md",
    "tsconfig.json"
  ],
  "scripts": {
    "build": "npm run check",
    "check": "tsc -p tsconfig.json --noEmit",
    "clean": "echo 'nothing to clean'",
    "test": "node --test --experimental-strip-types test/**/*.test.ts"
  },
  "exports": {
    ".": "./index.ts"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3"
  }
}
